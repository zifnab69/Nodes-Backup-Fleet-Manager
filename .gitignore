# Python — bytecode et caches
__pycache__/
*.py[cod]
*$py.class

# PyInstaller — artefacts de build EXE
build/
dist/
*.spec

# Profil de compilation EXE (chemins et versions propres à chaque machine)
exeprofil.ini

# Binaires compilés — ils ne vont PAS dans le dépôt.
# Un .exe se publie en pièce jointe d'une GitHub Release :
#   https://github.com/zifnab69/Nodes-Backup-Fleet-Manager/releases
*.exe

# Fichiers générés à l'exécution par NBFM (jamais à versionner)
NBFM_Config.json
NBFM_notes.json
NBFM_report_*.html

# Sauvegardes de nœuds (données utilisateur, propres à chaque machine)
*.NBFM
*.nbfm

# Dossier de versions horodatées du script (local uniquement, non synchronisé)
Backup/

# Dossiers d'executables (la règle visait « Executable/ » : le dossier réel
# s'appelle « Executables/ », la règle ne s'appliquait donc à rien)
Executables/

# Dossiers de travails
/Travails

# Environnements virtuels
.venv/
venv/
env/
# venv du projet, un par version (venv_NBFM_V1.96, venv_NBFM_V1.97…).
# Jusqu'ici ils n'étaient ignorés que par le .gitignore interne créé par Python
# dans le dossier lui-même — règle explicite ici, plus robuste.
venv_NBFM*/

# Divers IDE / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
# Fichiers verrou Word/Office (apparaissent quand on ouvre un .md dans Word)
~$*
